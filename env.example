# dsv4-flash-gb10-runtime — environment configuration
# Copy to .env and source it (or export in your shell) before running.

# Repo root (where this README.md lives)
export DSV4_HOME=/path/to/dsv4-flash-gb10-runtime

# Same as DSV4_HOME unless dependent kernels live in a separate tree.
# The runtime expects the following layout under DSV4_KERNEL_DEPS:
#   $DSV4_KERNEL_DEPS/kernel/fp8-dense/libfp8_e4m3_gemv.so
#   $DSV4_KERNEL_DEPS/kernel/mxfp4-dense/libmxfp4_gemv.so
#   $DSV4_KERNEL_DEPS/kernel/mxfp4-routed/libmxfp4_grouped_gemv.so
#   $DSV4_KERNEL_DEPS/kernel/rmsnorm-fuse/librmsnorm_fuse.so
export DSV4_KERNEL_DEPS=$DSV4_HOME

# DeepSeek-V4-Flash BF16 HuggingFace snapshot directory
# Download from:  https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash
# Expected files: model-*.safetensors, tokenizer.json, config.json
export DSV4_WEIGHTS=/path/to/DeepSeek-V4-Flash

# Output directory for validation harness JSON reports
export DSV4_OUT=$DSV4_HOME/out
